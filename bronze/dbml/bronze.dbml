Table bronze_coa_raw {
  chart_scope varchar [note: 'GROUP, 2010 or 2380. Added at ingest from the tab name — not a column in the sheet.']
  account varchar [note: 'Account code. Affiliates use 4-digit codes; the Group chart uses G-prefixed 5-digit nodes.']
  account_name varchar [note: 'Account description, leading spaces preserved — encodes Group chart hierarchy.']
  statement varchar [note: 'Balance sheet or Income statement.']
  category varchar [note: 'FS caption group, e.g. Non-current assets.']
  normal_balance varchar [note: 'Dr or Cr.']
  level varchar [note: 'Group chart only. 1 = face caption, 2 = analytical sub-account.']
  source_reference varchar [note: 'Group chart only. Where the node traces to in the interim report.']
  source_file varchar [note: 'Workbook filename this row was read from. Added at ingest.']
}

Table bronze_tb_raw {
  affiliate_code varchar [note: '2010 (SABIC) or 2380 (Petro Rabigh). Added at ingest from the tab name.']
  account varchar [note: '4-digit affiliate ledger code. Account rows only — dividers and subtotals dropped at ingest.']
  account_name varchar [note: 'Account description.']
  type varchar [note: 'BS or PL.']
  category varchar [note: 'FS caption group.']
  period_label varchar [note: 'Raw quarter header, e.g. 2024 Q1. Added at ingest by unpivoting.']
  amount varchar [note: 'Signed balance, kept as text.']
  source_file varchar [note: 'Workbook filename this row was read from.']
}

Table bronze_group_tb_raw {
  account varchar [note: 'G-prefixed 5-digit Group node code. Blank on subtotal rows.']
  group_node varchar [note: 'Group node name, or the subtotal caption where account is blank.']
  type varchar [note: 'Balance sheet or Income statement, long form — not normalised to BS/PL.']
  category varchar [note: 'FS caption group.']
  period_label varchar [note: 'Raw quarter header.']
  amount varchar [note: 'Signed balance. Aramco parent-only, no affiliates.']
  source_file varchar [note: 'Workbook filename this row was read from.']
}

Table bronze_ifrs_rubric_raw {
  standard varchar [note: 'Full standard name, e.g. IFRS 15 Revenue. Mapped from standard_name in the source CSV.']
  req varchar [note: 'Requirement code R1-R5. Mapped from req_id in the source CSV.']
  requirement varchar [note: 'The disclosure requirement text.']
  standard_code varchar [note: 'NEW. Short stable code, e.g. IFRS 15. FK target for the standard-level context table.']
  evidence_type varchar [note: 'NEW. narrative | table_structure | both — what kind of evidence satisfies this requirement.']
  check_guidance varchar [note: 'NEW. How to verify the requirement is met. Makes the rubric machine-actionable.']
  source_file varchar [note: 'Source filename. Re-sourced from ifrs_requirements_updated.csv; previously the xlsx rubric tab.']
}

Table bronze_ifrs_standard_raw {
  standard_code varchar [note: 'Short stable code, e.g. IFRS 15, IAS 24, IAS 16.']
  standard_title varchar [note: 'Full official title of the standard.']
  disclosure_summary varchar [note: 'Paragraph summarising what the standard requires to be disclosed.']
  source_file varchar [note: 'Source filename.']
}

Table bronze_entity_context_raw {
  context_key varchar [note: 'Metadata key, e.g. reporting_entity, presentation_currency, reportable_segments.']
  context_value varchar [note: 'Free-text value. Narrative reference data read by agents, not aggregated.']
  source_file varchar [note: 'Source filename.']
}

Table bronze_checklist_raw {
  item varchar [note: 'Checklist item number, 01-14.']
  document varchar [note: 'Required document name.']
  required varchar [note: 'Whether mandatory for a submission.']
  applies_to varchar [note: 'Which affiliates this requirement applies to.']
  expected_format varchar [note: 'Expected file format.']
  description varchar [note: 'What the document should contain.']
  source_file varchar [note: 'Workbook filename this row was read from.']
}

TableGroup financial_sources {
  bronze_coa_raw
  bronze_tb_raw
  bronze_group_tb_raw
}

TableGroup agent_reference_sources {
  bronze_ifrs_rubric_raw
  bronze_ifrs_standard_raw
  bronze_entity_context_raw
  bronze_checklist_raw
}
